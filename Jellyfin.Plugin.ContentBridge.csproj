<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ContentBridge</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.ContentBridge</AssemblyName>
    <AssemblyTitle>ContentBridge</AssemblyTitle>
    <Product>ContentBridge</Product>
    <Company>许诺</Company>
    <Copyright>Copyright (C) 2026 许诺</Copyright>
    <Description>Inject external content-source feeds into the Jellyfin library (strm virtual entries)</Description>
    <AssemblyVersion>0.3.0.3</AssemblyVersion>
    <FileVersion>0.3.0.3</FileVersion>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.10.7" />
    <PackageReference Include="Jellyfin.Common" Version="10.10.7" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- emby/ hosts the Emby binding project; tools/ holds dev-only utilities. -->
    <Compile Remove="emby\**" />
    <Compile Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
